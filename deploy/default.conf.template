# Serves the SPA and forwards every GlitchTip backend path to ${BACKEND_URL}.
# The browser only ever talks to this origin, so allauth's session cookie and
# Django's CSRF check work exactly as they do on the backend's own domain.

map $http_origin $backend_origin {
    ""      "";
    default ${BACKEND_URL};
}
map $http_cf_connecting_ip $client_ip {
    ""      $remote_addr;
    default $http_cf_connecting_ip;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    client_max_body_size 100m;

    location = /healthz { access_log off; return 200 "ok\n"; }

    location ~ ^/(api|_allauth|accounts|oauth|mcp|admin|media|static|\.well-known)(/|$) {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host ${BACKEND_HOST};
        # Django compares Origin/Referer with its own host.
        proxy_set_header Origin $backend_origin;
        proxy_set_header Referer ${BACKEND_URL}/;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
